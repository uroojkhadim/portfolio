# ==============================================================================
# UROOJ KHADIM PORTFOLIO — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to `.env` in the root directory for local development
# or configure these variables in your deployment dashboard (e.g. Vercel, Netlify).
#
# NOTE: The portfolio works 100% out-of-the-box even without any API keys!
# - Contact form persists messages to server/data/messages.json
# - Personal AI Chatbot uses the verified built-in knowledge-base engine
# - Adding the optional keys below activates live WhatsApp phone alerts & Google Gemini
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WHATSAPP NOTIFICATION CONFIGURATION (Pick any ONE provider)
# ------------------------------------------------------------------------------
# Set the WhatsApp number where you want to receive new contact notifications.
# Format: International E.164 without spaces (e.g., +923136576128)
WHATSAPP_RECIPIENT_PHONE=+923136576128

# OPTION A: Meta WhatsApp Business Cloud API (Official & Recommended for production)
# Setup: https://developers.facebook.com/apps/ -> WhatsApp -> API Setup
# Cost: First 1,000 service conversations per month are 100% FREE.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# OPTION B: CallMeBot Gateway (FREE, 60-second setup for personal WhatsApp alerts)
# Setup: Send "I allow callmebot to send me messages" via WhatsApp to +34 644 44 20 89
# Receive your free API key in reply, then set:
# CALLMEBOT_API_KEY=your_callmebot_api_key_here
# CALLMEBOT_PHONE=+923136576128
CALLMEBOT_API_KEY=
CALLMEBOT_PHONE=

# OPTION C: Twilio WhatsApp API
# Setup: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION (Optional - for Generative AI Chatbot)
# ------------------------------------------------------------------------------
# Get your free API key from Google AI Studio: https://aistudio.google.com/
# Free tier: 15 Requests Per Minute (RPM) — completely free for personal portfolios!
# If left blank, the chatbot automatically uses the built-in verified knowledge engine.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. SERVER CONFIGURATION (For standalone production Node server)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 4. ADMIN CMS CONFIGURATION
# ------------------------------------------------------------------------------
# JWT secret for admin authentication sessions (generate a secure random string)
JWT_SECRET=portfolio_cms_secret_change_in_production_2024
ADMIN_EMAIL=uroojkhadim505@gmail.com
ADMIN_DEFAULT_PASSWORD=khadim123

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATIONS (Optional - for email alerts on new contact messages)
# ------------------------------------------------------------------------------
# Configure SMTP credentials if you wish to receive email notifications when
# a new contact message is submitted. If unconfigured, notification is skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=uroojkhadim505@gmail.com

